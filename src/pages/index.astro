---
import { getCollection } from "astro:content";
import BaseLayout from '../layouts/BaseLayout.astro';
import { Info, GraduationCap, Rss, Contact, Box as BoxIcon, Brain, Code as CodeIcon, Map as MapIcon, SportShoe, Book } from "lucide-preact";
import Panels from '../components/Panels.astro';
import ImageLightbox from '../components/ImageLightbox.jsx';

const pageTitle = "Josh Olivier - Home";

// Get top 3 blog tags by frequency
const allPosts = await getCollection("blog");
const tagCounts: Record<string, number> = {};
allPosts.forEach(post => {
  post.data.tags?.forEach(tag => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

const topTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 3)
  .map(([tag]) => tag);

const getTagThemeClass = (tag: string) => `tag-theme-${tag.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;

const tagIcons: Record<string, any> = {
  '3dprinting': BoxIcon,
  neuroscience: Brain,
  blogging: Rss,
  code: CodeIcon,
  travel: MapIcon,
  triathlon: SportShoe,
  books: Book,
};

const getTagIcon = (tag: string) => tagIcons[tag.toLowerCase()] ?? null;
---
<BaseLayout pageTitle={pageTitle} titleHtml="Josh Olivier" shouldCenterTitle={false} titlePrefix={false} ogImage="/social-cards/home.png">

<Panels />

<ImageLightbox client:load />

<p>I'm a psychology PhD student in the 

  <a href="https://dzlab.ucr.edu" 
    target="_blank" 
    rel="noopener noreferrer">Dimsdale-Zucker Memory and Context Lab</a>

  at the University of California, Riverside. 
  I'm interested in memory, aging, and brain activity 
  and have experience in neuroimaging and cognitive neuroscience research.
Check out any of the links below to learn more about me and my work.
</p>



<div class="explore-grid">
  <a href="/about" class="explore-card">
    <span class="explore-card-icon"><Info size="1.5rem" /></span>
    <span class="explore-card-title">About</span>
    <span class="explore-card-desc">My background, research interests, and what I'm up to.</span>
  </a>
  <a href="/cv" class="explore-card">
    <span class="explore-card-icon"><GraduationCap size="1.5rem" /></span>
    <span class="explore-card-title">CV</span>
    <span class="explore-card-desc">My academic and professional history.</span>
  </a>
  <a href="/blog" class="explore-card">
    <span class="explore-card-icon"><Rss size="1.5rem" /></span>
    <span class="explore-card-title">Blog</span>
    <span class="explore-card-desc">
      Posts on
      {topTags.map((tag, index) => {
        const TagIcon = getTagIcon(tag);
        return (
          <span style="display: inline-block; white-space: nowrap;">
            <span class={`tag tag-blogsorter ${getTagThemeClass(tag)}`}>
              {TagIcon ? <TagIcon size="0.875rem" aria-hidden="true" /> : <span aria-hidden="true">#</span>}
              <span>{tag}</span>
            </span>
            {index < topTags.length - 1 && <>, </>}
          </span>
        );
      })}
      , and more.
    </span>
  </a>
  <a href="/contact" class="explore-card">
    <span class="explore-card-icon"><Contact size="1.5rem" /></span>
    <span class="explore-card-title">Contact</span>
    <span class="explore-card-desc">Get in touch or connect with me on social media.</span>
  </a>
</div>
</BaseLayout>

<script>
  document.querySelectorAll('.explore-card').forEach((card) => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
      card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
    });
  });
</script>
