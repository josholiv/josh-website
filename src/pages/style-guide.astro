---
import BaseLayout from '../layouts/BaseLayout.astro';
import Callout from '../components/Callout.astro';
import Dropdown from '../components/Dropdown.astro';
import Panels from '../components/Panels.astro';
import Social from '../components/social.astro';
import { Bike, Cog as CogIcon, Dna, Rss, Code as CodeIcon, Map as MapIcon, SportShoe, BookOpen, Activity, Globe, Radio, Briefcase, GraduationCap } from "lucide-preact";

const isDev = import.meta.env.DEV;
if (!isDev) return Astro.redirect('/404');

const tsxSnippet = `const fetchChessStats = async (username: string) => {
  const url = 'https://api.chess.com/pub/player/' + username + '/stats';
  const response = await fetch(url);
  return await response.json();
};`;

const bashSnippet = `npm install astro-expressive-code`;
---

<BaseLayout pageTitle="Style Guide" titleHtml="Style Guide <span class='title-muted'>/ dev only</span>" shouldCenterTitle={false}>

<Panels />

  <!-- ─── Typography ─── -->
  <h2>Typography</h2>

  <h1>Heading 1 — Atkinson Hyperlegible Next</h1>
  <h2>Heading 2 — Atkinson Hyperlegible Next</h2>
  <h3>Heading 3 — Atkinson Hyperlegible Next, italic</h3>
  <h4>Heading 4 — Atkinson Hyperlegible Next</h4>
  <h5>Heading 5 — Atkinson Hyperlegible Next, italic</h5>
  <h6>Heading 6 — Atkinson Hyperlegible Next</h6>
  <p>Body text — Atkinson Hyperlegible Next. The quick brown fox jumps over the lazy dog. <strong>Bold text.</strong> <em>Italic text.</em> <strong><em>Bold italic.</em></strong></p>
  <p>A paragraph with an <a href="#">inline link</a> and an <a href="https://example.com" target="_blank">external link</a> (should show external link icon).</p>
  <p class="title-muted">Muted text using <code>.title-muted</code></p>

  <hr />

  <!-- ─── Code ─── -->
  <h2>Inline Code</h2>
  <p>Use <code>const x = 1</code> for inline code. Or reference a class like <code>.post-wrapper</code>.</p>

  <hr />

  <!-- ─── Code Blocks ─── -->
  <h2>Code Blocks</h2>
  <p>Fenced code blocks, rendered with Expressive Code and synced to the site's light/dark theme via <code>--code-bg</code> and <code>--code-text</code>.</p>

  <div class="demo-code-frame">
    <div class="demo-code-header">chess-stats.tsx</div>
    <pre class="demo-code-body"><code set:text={tsxSnippet} /></pre>
  </div>

  <div class="demo-code-frame">
    <pre class="demo-code-body"><code set:text={bashSnippet} /></pre>
  </div>

  <hr />

  <!-- ─── Buttons ─── -->
  <h2>Buttons</h2>
  <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center;">
    <button class="btn">Default Button</button>
    <button class="btn icon-container-inline">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"></polyline></svg>
      With Icon
    </button>
    <Dropdown options={['Option A', 'Option B', 'Option C']} />
  </div>

  <hr />

  <!-- ─── Checkboxes ─── -->
  <h2>Checkboxes</h2>
  <p>Used for the blog sidebar's tag filters and task lists in posts.</p>
  <div style="display: flex; flex-direction: column; gap: 0.5rem;">
    <label style="display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer;">
      <input type="checkbox" /> Unchecked
    </label>
    <label style="display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer;">
      <input type="checkbox" checked /> Checked
    </label>
    <label style="display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer;">
      <input type="checkbox" disabled /> Disabled
    </label>
    <label style="display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer;">
      <input type="checkbox" checked disabled /> Disabled, checked
    </label>
  </div>

  <hr />

  <!-- ─── Search & Sort Controls ─── -->
  <h2>Search &amp; Sort Controls</h2>
  <p>Used on the blog page to search and sort posts.</p>
  <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center;">
    <div style="position: relative;">
      <input type="text" placeholder="Search..." class="blog-search" />
      <kbd class="blog-search-kbd">/</kbd>
    </div>
    <select class="sort-select">
      <option>Newest → oldest</option>
      <option>Oldest → newest</option>
    </select>
  </div>

  <hr />

  <!-- ─── Tags ─── -->
  <h2>Tags</h2>
  <p>Clickable tags (used on post pages, link to the blog with that tag selected):</p>
  <div class="tags">
    <span class="tag tag-theme-3dprinting"><CogIcon size="0.9rem" class="tag-icon" /> <span>3Dprinting</span></span>
    <span class="tag tag-theme-science"><Dna size="0.9rem" class="tag-icon" /> <span>science</span></span>
    <span class="tag tag-theme-blogging"><Rss size="0.9rem" class="tag-icon" /> <span>blog</span></span>
    <span class="tag tag-theme-code"><CodeIcon size="0.9rem" class="tag-icon" /> <span>code</span></span>
  </div>

  <p>Display-only tags (used on blog post cards):</p>
  <div class="tags">
    <span class="tag-blogsorter tag-theme-travel"><MapIcon size="0.9rem" class="tag-icon" /> <span>travel</span></span>
    <span class="tag-blogsorter tag-theme-triathlon"><SportShoe size="0.9rem" class="tag-icon" /> <span>triathlon</span></span>
    <span class="tag-blogsorter tag-theme-code"><CodeIcon size="0.9rem" class="tag-icon" /> <span>code</span></span>
  </div>

  <p>Tag filter checkboxes with counts (used in the blog sidebar's Tags panel):</p>
  <ul class="tag-filter-list" style="list-style: none; padding: 0;">
    <li class="tag-filter-item">
      <label class="tag-filter-label">
        <input type="checkbox" class="tag-filter-checkbox" checked />
        <span class="tag tag-theme-3dprinting"><CogIcon size="0.9rem" class="tag-icon" /> <span>3Dprinting</span> <span class="tag-count">(4)</span></span>
      </label>
    </li>
    <li class="tag-filter-item">
      <label class="tag-filter-label">
        <input type="checkbox" class="tag-filter-checkbox" />
        <span class="tag tag-theme-science"><Dna size="0.9rem" class="tag-icon" /> <span>science</span> <span class="tag-count">(12)</span></span>
      </label>
    </li>
    <li class="tag-filter-item">
      <label class="tag-filter-label">
        <input type="checkbox" class="tag-filter-checkbox" />
        <span class="tag tag-theme-travel"><MapIcon size="0.9rem" class="tag-icon" /> <span>travel</span> <span class="tag-count">(3)</span></span>
      </label>
    </li>
  </ul>

  <hr />

  <!-- ─── Blockquote ─── -->
  <h2>Blockquote</h2>
  <div class="blockquote">
    This is a plain blockquote. It has no background color and uses <code>var(--bg-secondary)</code> 
    as its left border color.
  </div>

  <div class="blockquote">
    If I make the text inside the blockquote really long, it should wrap and the blockquote should expand vertically to fit the content. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec a diam lectus. Sed sit amet ipsum mauris. Maecenas congue ligula ac quam viverra nec consectetur ante hendrerit. Donec et mollis dolor.
  </div>

  <hr />

  <!-- ─── Callouts ─── -->
    <h2>Callouts</h2>

  <Callout type="note">
    This is a <strong>note</strong> callout. Use it for supplementary information or asides.
  </Callout>

  <Callout type="example">
    This is an <strong>example</strong> callout. Useful for illustrating concepts with sample content.
  </Callout>

  <Callout type="info">
    This is an <strong>info</strong> callout. Use it for general information or context. Has a link: <a href="#">click here</a>.
  </Callout>

  <Callout type="todo">
    This is a <strong>todo</strong> callout. Use it for action items embedded in notes.
  </Callout>

  <Callout type="tip">
    This is a <strong>tip</strong> callout. Use it for helpful hints or best practices.
  </Callout>

  <Callout type="hint">
    This is a <strong>hint</strong> callout. An alias for tip.
  </Callout>

  <Callout type="important">
    This is an <strong>important</strong> callout. Another alias for tip.
  </Callout>

  <Callout type="success">
    This is a <strong>success</strong> callout. Use it to confirm something worked or highlight a positive outcome.
  </Callout>

  <Callout type="check">
    This is a <strong>check</strong> callout. An alias for success.
  </Callout>

  <Callout type="done">
    This is a <strong>done</strong> callout. An alias for success.
  </Callout>

  <Callout type="warning">
    This is a <strong>warning</strong> callout. Use it to flag something the reader should be cautious about.
  </Callout>

  <Callout type="caution">
    This is a <strong>caution</strong> callout. An alias for warning.
  </Callout>

  <Callout type="attention">
    This is an <strong>attention</strong> callout. An alias for warning.
  </Callout>

  <Callout type="faq">
    This is a <strong>faq</strong> callout. Good for anticipated questions.
  </Callout>

  <Callout type="question">
    This is a <strong>question</strong> callout. An alias for faq.
  </Callout>

  <Callout type="help">
    This is a <strong>help</strong> callout. An alias for faq.
  </Callout>

  <Callout type="danger">
    This is a <strong>danger</strong> callout. Reserved for serious errors or destructive actions.
  </Callout>

  <Callout type="error">
    This is an <strong>error</strong> callout. An alias for danger.
  </Callout>

  <Callout type="bug">
    This is a <strong>bug</strong> callout. Useful for known issues in documentation.
  </Callout>

  <Callout type="failure">
    This is a <strong>failure</strong> callout. An alias for danger.
  </Callout>

  <Callout type="fail">
    This is a <strong>fail</strong> callout. An alias for danger.
  </Callout>

  <Callout type="missing">
    This is a <strong>missing</strong> callout. An alias for danger.
  </Callout>

  <Callout type="quote">
    This is a <strong>quote</strong> callout. Matches your blockquote style with a neutral border.
  </Callout>

  <Callout type="cite">
    This is a <strong>cite</strong> callout. An alias for quote.
  </Callout>

  <Callout type="code">
    This is a <strong>code</strong> callout. It uses the neutral gray treatment like quote, but with a code icon.
  </Callout>

  <Callout type="abstract">
    This is an <strong>abstract</strong> callout. Good for summaries at the top of long notes.
  </Callout>

  <Callout type="summary">
    This is a <strong>summary</strong> callout. An alias for abstract.
  </Callout>

  <Callout type="tldr">
    This is a <strong>tldr</strong> callout. An alias for abstract.
  </Callout>

  <hr />

  <h2>Customizing callouts</h2>

   <h3>Collapsible callouts</h3>

  <Callout type="note" collapsible defaultOpen={true}>
    This is a collapsible callout. It's set to be open using <code>defaultOpen={true}</code>.
  </Callout>

  <Callout type="warning" collapsible>
    This one starts collapsed, which is the default behavior when using the <code>collapsible</code> prop without specifying <code>defaultOpen</code>.
  </Callout>

  <h3>Custom titles, icons, and more</h3>

  <Callout type="info" title={`Custom callout`} icon={Bike}>
    This is a customized callout. I overrode the default title and icon of the <code>info</code> callout with custom properties.
  </Callout>

  <Callout type="note"> 
    <span slot="title">
      Check out my <a href="/about">about page</a>
    </span>
    This callout has a linked title using the named title slot.
  </Callout>

  <Callout type="tip" title={`You can also create a callout with just a title`}></Callout>

  <hr />

  <!-- ─── Rainbow Divider ─── -->
  <h2>Rainbow Divider</h2>
  <hr class="rainbow-hr">

  <hr>

  <!-- ─── Wave Divider ─── -->
  <h2>Wave Divider</h2>
  <div class="wave-container">
    <div class="wave wave-small"></div>
    <div class="wave wave-big"></div>
  </div>

  <hr />

  <!-- ─── Lists ─── -->
  <h2>Lists</h2>
  <ul>
    <li>Unordered list item one</li>
    <li>Unordered list item two</li>
    <li>Unordered list item three</li>
  </ul>
  <ol>
    <li>Ordered list item one</li>
    <li>Ordered list item two</li>
    <li>Ordered list item three</li>
  </ol>

  <hr />

  <!-- ─── Explore Cards ─── -->
  <h2>Explore Cards</h2>
  <p>Used on the homepage and about page to link to sections. Mouse over to see the glow effect.</p>
  <div class="explore-grid">
    <a href="#" class="explore-card">
      <span class="explore-card-icon"><BookOpen size="1.25rem" /></span>
      <span class="explore-card-title">Bookshelf</span>
      <span class="explore-card-desc">Books I've read, rated, and reviewed.</span>
    </a>
    <a href="#" class="explore-card">
      <span class="explore-card-icon"><Activity size="1.25rem" /></span>
      <span class="explore-card-title">Triathlon</span>
      <span class="explore-card-desc">Training data and race results.</span>
    </a>
    <a href="#" class="explore-card">
      <span class="explore-card-icon"><Globe size="1.25rem" /></span>
      <span class="explore-card-title">Travel</span>
      <span class="explore-card-desc">Places I've been and trips I've taken.</span>
    </a>
    <a href="#" class="explore-card">
      <span class="explore-card-icon"><CodeIcon size="1.25rem" /></span>
      <span class="explore-card-title">Projects</span>
      <span class="explore-card-desc">Side projects, tools, and experiments.</span>
    </a>
  </div>

  <hr />

  <!-- ─── Blog Post Card ─── -->
  <h2>Blog Post Card</h2>
  <p>Used in the blog post list. Mouse over to see the glow effect.</p>
  <ul class="blog-list">
    <li class="blog-post">
      <a href="#" class="post-wrapper post-card-link">
        <div class="post-text">
          <div class="post-tag-icons">
            <span class="tag-post-icon tag-theme-3dprinting"><CogIcon size="1.25rem" aria-label="3dprinting" /></span>
            <span class="tag-post-icon tag-theme-science"><Dna size="1.25rem" aria-label="science" /></span>
            <span class="pub-date">Jun 2026 | <span class="post-read-time">5 min</span></span>
          </div>
          <div class="post-title">Example blog post title</div>
        </div>
      </a>
    </li>
  </ul>

  <hr />

  <!-- ─── Stat Cards ─── -->
  <h2>Stat Cards</h2>
  <p>Used on the bookshelf and about pages to display key numbers. Mouse over to see the glow effect.</p>
  <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 1.5rem;">
    <div class="stat-card">
      <span class="stat-card-icon"><BookOpen size="1.1rem" /></span>
      <span class="stat-card-number">142</span>
      <span class="stat-card-label">books read</span>
    </div>
    <div class="stat-card">
      <span class="stat-card-icon"><Activity size="1.1rem" /></span>
      <span class="stat-card-number">4.2</span>
      <span class="stat-card-label">avg rating</span>
    </div>
    <div class="stat-card">
      <span class="stat-card-icon"><Globe size="1.1rem" /></span>
      <span class="stat-card-number">31</span>
      <span class="stat-card-label">countries</span>
    </div>
  </div>

  <hr />

  <!-- ─── Social Links ─── -->
  <h2>Social Links</h2>
  <p>Used in the Links sidebar panel and, on small screens, the footer.</p>
  <ul class="social-container" style="list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 1rem;">
    <li><Social platform="github.com" username="josholiv" icon={CodeIcon} displayName="GitHub" /></li>
    <li><Social platform="bsky.app" username="profile/josholivier.bsky.social" icon={Radio} displayName="Bluesky" /></li>
    <li><Social platform="linkedin.com" username="in/joshua-olivier/" icon={Briefcase} displayName="LinkedIn" /></li>
    <li><Social platform="orcid.org/" username="0009-0002-3696-5552" icon={GraduationCap} displayName="ORCiD" /></li>
  </ul>

  <hr />

  <!-- ─── Color Palette ─── -->
  <h2>Color Palette</h2>

  {[
    { name: 'blue',    shades: ['050','100','200','300','400','500','600','700','800','900','950'] },
    { name: 'green',   shades: ['050','100','200','300','400','500','600','700','800','900','950'] },
    { name: 'orange',  shades: ['050','100','200','300','400','500','600','700','800','900','950'] },
    { name: 'yellow',  shades: ['050','100','200','300','400','500','600','700','800','900','950'] },
    { name: 'red',     shades: ['050','100','200','300','400','500','600','700','800','900','950'] },
    { name: 'pink',    shades: ['050','100','200','300','400','500','600','700','800','900','950'] },
    { name: 'purple',  shades: ['050','100','200','300','400','500','600','700','800','900','950'] },
    { name: 'cyan',    shades: ['050','100','200','300','400','500','600','700','800','900','950'] },
    { name: 'neutral', shades: ['050','100','200','300','400','500','600','700','800','900','950'] },
  ].map(({ name, shades }) => (
    <div style="margin-bottom: 0.75rem;">
      <p style="margin: 0 0 0.35rem; font-family: 'Atkinson Hyperlegible Mono Variable', 'Atkinson Hyperlegible Mono Fallback', monospace; font-size: 0.875rem;">{name}</p>
      <div style="display: flex; gap: 2px;">
        {shades.map(shade => (
          <div
            title={`--${name}-${shade}`}
            style={`background-color: var(--${name}-${shade}); width: 2rem; height: 2rem; border-radius: 2px; flex-shrink: 0;`}
          />
        ))}
      </div>
    </div>
  ))}

  <hr />

  <!-- ─── Theme Tokens ─── -->
  <h2>Theme Tokens</h2>
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
    {[
      'bg-primary', 'bg-secondary', 'bg-border',
      'text-normal', 'text-muted', 'text-faint', 'text-heading', 'text-on-accent',
      'accent', 'accent-hover', 'link-color', 'link-color-hover',
      'code-bg', 'code-text', 'code-border',
      'btn-text', 'btn-text-hover',
    ].map(token => (
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <div style={`background-color: var(--${token}); width: 1.5rem; height: 1.5rem; border-radius: 2px; border: 1px solid var(--bg-border); flex-shrink: 0;`} />
        <code>--{token}</code>
      </div>
    ))}
  </div>

</BaseLayout>

<style>
  .demo-code-frame {
    border-radius: 7px;
    overflow: hidden;
    background-color: var(--code-bg);
    margin-bottom: 1rem;
  }

  .demo-code-header {
    padding: 0.4rem 0.75rem;
    font-family: "Atkinson Hyperlegible Mono Variable", "Atkinson Hyperlegible Mono Fallback", monospace;
    font-size: 0.8rem;
    color: var(--text-faint);
    background-color: var(--bg-secondary);
    border-bottom: 1px solid var(--bg-border);
  }

  .demo-code-body {
    margin: 0;
    padding: 0.5rem 0.75rem;
    overflow-x: auto;
    font-family: "Atkinson Hyperlegible Mono Variable", "Atkinson Hyperlegible Mono Fallback", monospace;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--code-text);
  }
</style>

<script>
  document.querySelectorAll('.stat-card, .explore-card, .post-card-link').forEach((card) => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
      card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
    });
  });
</script>