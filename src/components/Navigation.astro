---
import { Home, Info, GraduationCap, Rss, Contact } from "lucide-preact";
const pathname = Astro.url.pathname;

const isHome = pathname === "/" || pathname === "/home" || pathname === "/home/";
const isAbout = pathname === "/about" || pathname === "/about/";
const isCv = pathname === "/cv" || pathname === "/cv/";
const isBlog = pathname.startsWith("/blog") || pathname.startsWith("/posts") || pathname.startsWith("/tags");
const isContact = pathname === "/contact" || pathname === "/contact/";
---
<div class="nav-container">
<div class="nav-links" id="nav-links">
  <div class="nav-links-inner">
    <a href="/" class={isHome ? "active" : ""} aria-current={isHome ? "page" : undefined}>
    <span class="icon-container">
      <Home size={"1rem"} class="nav-icon" aria-hidden="true"/>
      Home
    </span>
  </a>
  <a href="/about" class={isAbout ? "active" : ""} aria-current={isAbout ? "page" : undefined}>
    <span class="icon-container">
      <Info size={"1rem"} class="nav-icon" aria-hidden="true"/>
      About
    </span>
  </a>
  <a href="/cv" class={isCv ? "active" : ""} aria-current={isCv ? "page" : undefined}>
    <span class="icon-container">
      <GraduationCap size={"1rem"} class="nav-icon" aria-hidden="true"/>
      CV
    </span>
  </a>
  <a href="/blog" class={isBlog ? "active" : ""} aria-current={isBlog ? "page" : undefined}>
    <span class="icon-container">
      <Rss size={"1rem"} class="nav-icon" aria-hidden="true"/>
      Blog
    </span>
  </a>
  <a href="/contact" class={isContact ? "active" : ""} aria-current={isContact ? "page" : undefined}>
    <span class="icon-container">
      <Contact size={"1rem"} class="nav-icon" aria-hidden="true"/>
      Contact
    </span>
  </a>
  </div>
</div>

</div>
